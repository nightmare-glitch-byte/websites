# Copy this file to .env for Docker Compose and to .env.local for Next.js.
# Replace every development credential before exposing any service to a network.
POSTGRES_DB=aura
POSTGRES_USER=aura
POSTGRES_PASSWORD=change-this-local-postgres-password
DATABASE_URL=postgresql://aura:change-this-local-postgres-password@127.0.0.1:5432/aura

MINIO_ROOT_USER=aura-local-admin
MINIO_ROOT_PASSWORD=change-this-local-minio-password
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=aura-media
S3_ACCESS_KEY_ID=aura-local-admin
S3_SECRET_ACCESS_KEY=change-this-local-minio-password
S3_FORCE_PATH_STYLE=true
